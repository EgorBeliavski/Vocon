<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Vocon.Pages.SettingsPage"
             Title="Настройки">

    <ScrollView>
        <Grid Padding="20"
              RowSpacing="16"
              ColumnSpacing="12"
              ColumnDefinitions="140,*"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto">

            <!-- Язык заметок -->
            <Label Grid.Row="0" Grid.Column="0"
                   Text="Tags language"
                   VerticalOptions="Center" />
            <Picker Grid.Row="0" Grid.Column="1"
                    ItemsSource="{Binding NoteLanguages}"
                    SelectedItem="{Binding SelectedNoteLanguage}"
                    ItemDisplayBinding="{Binding DisplayName}"
                    Title="Pick language" />    

            <!-- Микрофон -->
            <Label Grid.Row="1" Grid.Column="0"
                   Text="Micro"
                   VerticalOptions="Center" />
            <Grid Grid.Row="1" Grid.Column="1"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
                <Picker Grid.Column="0"
                        ItemsSource="{Binding AvailableMicrophones}"
                        SelectedItem="{Binding SelectedMicrophone}"
                        Title="Puck input device" />
                <Button Grid.Column="1"
                        Text="⟳"
                        Command="{Binding RefreshMicrophonesCommand}"
                        WidthRequest="30"
                        HeightRequest="30"
                        Padding="0" />
            </Grid>

            <!-- Hotkey -->
            <Label Grid.Row="2" Grid.Column="0"
                   Text="Hotkey"
                   VerticalOptions="Center" />
            <Grid Grid.Row="2" Grid.Column="1"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
                <Entry Grid.Column="0"
                       Text="{Binding HotkeyDisplay}"
                       IsReadOnly="True"
                       Placeholder="Alt + Space" />
                <Button Grid.Column="1"
                        Text="Change"
                        Command="{Binding StartHotkeyCaptureCommand}" />
            </Grid>

            <!-- Предупреждение о конфликте hotkey -->
            <Label Grid.Row="3" Grid.Column="1"
                   Text="{Binding HotkeyConflictWarning}"
                   TextColor="Red"
                   FontSize="12"
                   IsVisible="{Binding HasHotkeyConflict}" />

            <!-- Автозапуск -->
            <Label Grid.Row="4" Grid.Column="0"
                   Text="Auto-launch Windows"
                   VerticalOptions="Center" />
            <Switch Grid.Row="4" Grid.Column="1"
                    IsToggled="{Binding LaunchOnStartup}"
                    HorizontalOptions="Start" />

        </Grid>
    </ScrollView>
</ContentPage>