<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Vocon.MainPage">

    <Grid RowDefinitions="*,Auto" ColumnDefinitions="*,*" Padding="20">

        <CollectionView Grid.Row="0" 
                    Grid.Column="0" 
                    Grid.ColumnSpan="2"
                    ItemsSource="{Binding Notes}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10" Margin="0,0,0,8" StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout>
                            <Label Text="{Binding Title}" FontAttributes="Bold"/>
                            <Label Text="{Binding Transcription}" 
                               LineBreakMode="TailTruncation" 
                               MaxLines="2"/>
                            <Label Text="{Binding Date, StringFormat='{0:dd.MM.yyyy HH:mm}'}" 
                               FontSize="18" 
                               TextColor="Gray"/>
                            <Label Text="{Binding Tag}" FontSize="18" TextColor="Gray"/>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Text="{Binding RecordButtonText}" 
            Command="{Binding ToggleRecordingCommand}"
            Grid.Row="1" 
            Grid.Column="0" 
            Grid.ColumnSpan="2"
            WidthRequest="100"
            HorizontalOptions="Center"/>
    </Grid>
</ContentPage>